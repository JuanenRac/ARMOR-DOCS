{
  "ble.pairing.passkey": {"repo": "ARMOR-COMMON", "file": "firmware_base/main/ble_provision.cpp", "pattern": "sm_io_cap\\s*=\\s*BLE_HS_IO_DISPLAY_ONLY", "says": "the node shows a PIN and the phone types it"},
